# ═══════════════════════════════════════════════════════════════════════════
# صقر SAQR — ملف البيئة (.env)
# انسخ:  cp .env.example .env
# ثم عبّئ القيم أدناه. لا ترفع .env إلى GitHub أبداً.
# ═══════════════════════════════════════════════════════════════════════════

# ─── وضع التشغيل ───
# demo     = لوحة + محاكاة (بدون أوامر حقيقية)
# testnet  = باينانس Testnet (مفاتيح testnet)
# live     = تداول حقيقي — فقط بعد مراجعة المخاطر
SAQR_MODE=demo
SAQR_INITIAL_BALANCE_USD=500
SAQR_SYMBOL=BTCUSDT

# ═══════════════════════════════════════════════════════════════════════════
# باينانس — API + روابط المنصة (Spot)
# ═══════════════════════════════════════════════════════════════════════════
BINANCE_API_KEY=
BINANCE_API_SECRET=

# true = Testnet | false = Live
BINANCE_TESTNET=true

# REST API (لا تغيّر إلا إذا تعرف endpoint مخصص)
# Testnet:
BINANCE_REST_URL=https://testnet.binance.vision
# Live (عند BINANCE_TESTNET=false):
# BINANCE_REST_URL=https://api.binance.com

# WebSocket (بث الأسعار والعمق)
BINANCE_WS_URL=wss://testnet.binance.vision
# Live:
# BINANCE_WS_URL=wss://stream.binance.com:9443

# روابط الويب (للمرجع / لوحة خارجية — اختياري)
BINANCE_SPOT_WEB_URL=https://www.binance.com/en/trade/BTC_USDT
# Testnet واجهة:
# BINANCE_SPOT_WEB_URL=https://testnet.binance.vision/

# نافذة توقيع الأوامر (ms) — recvWindow
BINANCE_RECV_WINDOW=5000

# ═══════════════════════════════════════════════════════════════════════════
# تيليجرام — تنبيهات صقر
# ═══════════════════════════════════════════════════════════════════════════
# من @BotFather
TELEGRAM_BOT_TOKEN=

# معرف المحادثة (رقم سالب للمجموعات) — @userinfobot أو getUpdates
TELEGRAM_CHAT_ID=

# بوت احتياطي عند Flood / Too Many Requests (اختياري)
TELEGRAM_SECONDARY_BOT_TOKEN=

# ═══════════════════════════════════════════════════════════════════════════
# السيرفر السحابي — SSH + رابط لوحتك العامة
# ═══════════════════════════════════════════════════════════════════════════
# IP أو دومين السيرفر
CLOUD_SERVER_HOST=

# SSH (افتراضي 22)
CLOUD_SERVER_PORT=22
CLOUD_SERVER_SSH_USER=
CLOUD_SERVER_PASSWORD=

# مسار مفتاح SSH على جهازك (اختياري — للنشر اليدوي)
# CLOUD_SERVER_SSH_KEY_PATH=~/.ssh/id_rsa

# الرابط العام لصفحتك / لوحة صقر (HTTPS بعد Caddy/Nginx)
# مثال: https://saqr.yourdomain.com
SAQR_PUBLIC_DASHBOARD_URL=

# ═══════════════════════════════════════════════════════════════════════════
# لوحة التحكم (Control Terminal) على السيرفر
# ═══════════════════════════════════════════════════════════════════════════
# 0.0.0.0 = يقبل اتصالات من خارج localhost (مطلوب على السحابة)
SAQR_WEB_BIND_HOST=0.0.0.0
SAQR_WEB_BIND_PORT=8787

# ═══════════════════════════════════════════════════════════════════════════
# السجلات
# ═══════════════════════════════════════════════════════════════════════════
LOG_LEVEL=info
RUST_LOG=info,saqr_core=debug
