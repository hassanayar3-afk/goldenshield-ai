ENV=development
SAqr_ROOT=C:\Saqr_Binance
PAPER_TRADING=true
EXECUTION_MODE=paper
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://fapi.binance.com
BINANCE_MARKET_WS_URL=wss://stream.binance.com:9443
BINANCE_USER_WS_BASE=wss://fstream.binance.com/ws
TRI_COMMANDER_MODE=true
MAX_ELITE_CONCURRENT_POSITIONS=20
ELITE_MIN_PERCENT=85
SMC_MAX_CONCURRENT=4
GOLD_FLASH_MAX_CONCURRENT=12
MICRO_MOMENTUM_MAX_CONCURRENT=5
PORTFOLIO_HEAT_CAP_PCT=0.07
RISK_PCT_GOLDEN=0.02
RISK_PCT_STRONG=0.015
RISK_PCT_MEDIUM=0.01
MOBILE_API_PORT=8000
TERMINAL_WS_PORT=8000
MOBILE_WEB_DIRECT_ACCESS=true
DB_PATH=database/saqr_local.db
LISTEN_KEY_KEEPALIVE_MINUTES=30
RECOVERY_STOP_PCT=1.5
MAX_SPREAD_BPS=15
NO_SLEEP_MODE=true
BOT_FORCE_ACTIVE=true
LOOP_INTERVAL_SECONDS=4
WATCHDOG_ENABLED=true
