@echo off
REM Shared GoldenShield environment — Binance only, No-Sleep, Single Instance
REM Called by start_bot / restart_bot / stop_bot

set "GS_ROOT=C:\GoldenShield_Binance"
set "GS_TASK=GoldenShieldBotOfficial"
set "GS_DB=%GS_ROOT%\storage\db\goldenshield.db"
set "GS_RUNTIME=%GS_ROOT%\storage\runtime"
set "GS_LOGS=%GS_ROOT%\storage\logs"
set "GS_KILL=%GS_ROOT%\scripts\gs_kill_all.ps1"
set "GS_CORE=%GS_ROOT%\run_bot_visible.cmd"
set "GS_PULSE=%GS_ROOT%\live_console.ps1"

set "PYTHONPATH=%GS_ROOT%"
set "PYTHONIOENCODING=utf-8"
set "PYTHONUNBUFFERED=1"
set "GOLDENSHIELD_OFFICIAL_ROOT=%GS_ROOT%"
set "GOLDENSHIELD_ENFORCE_OFFICIAL_ROOT=true"
set "GOLDENSHIELD_LOCK_FAIL_CLOSED=true"
set "DB_PATH=%GS_DB%"
set "BOT_FORCE_ACTIVE=true"
set "HYBRID_SIGNAL_MODE=true"
set "PROJECT_REFERENCE_CAPITAL=5000"
set "PROJECT_MIN_TRADE_NOTIONAL=25"
set "PROJECT_MIN_EXCHANGE_NOTIONAL=5"
set "AUTO_ENTRY_MIN_PERCENT=90"
set "TELEGRAM_SIGNAL_MIN_PERCENT=70"
set "MANUAL_ENTRY_REQUIRED=false"
set "TELEGRAM_LIVE_SIGNALS=true"
set "NO_SLEEP_MODE=true"
set "LOOP_INTERVAL_SECONDS=4"
set "TELEGRAM_LIVE_SIGNALS_SECONDS=4"
set "TELEGRAM_LIVE_POSITIONS_SECONDS=3"
set "ENTERPRISE_PIPELINE_ENABLED=true"
set "SSOT_SYNC_ENABLED=true"
set "POST_MORTEM_ENGINE_ACTIVE=true"
set "CIRCUIT_BREAKER_MAX_LOSSES=3"
set "EXECUTION_BACKEND=binance"
