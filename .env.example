# بيئة التشغيل: dev | staging | production
ENV=dev

# Binance API — مطلوب لوضع live على Binance فقط
BINANCE_API_KEY=
BINANCE_API_SECRET=
# مفتاح احتياطي للتبديل عند Rate Limit (v1.3)
BINANCE_API_KEY_2=
BINANCE_API_SECRET_2=
# true = مفاتيح demo.binance.com (Demo Trading)
BINANCE_DEMO_TRADING=false

# Telegram — البوت: @GoldenShield_2026_bot
TELEGRAM_TOKEN=
TELEGRAM_BOT_USERNAME=GoldenShield_2026_bot
TELEGRAM_CHAT_ID=

# قناة الأرشيف الرسمية: https://t.me/ilord16
TELEGRAM_BACKUP_CHANNEL_ID=-1004462420308

# إرسال ملخص كل دورة (WAIT وغيرها) — يُفضّل false
TELEGRAM_SEND_CYCLE_SIGNALS=false
# true = تيليجرام فقط: إشارات دخول + فتح/إغلاق صفقة + طوارئ
TELEGRAM_SIGNALS_ONLY=true

# فترة فحص السوق بالثواني
LOOP_INTERVAL_SECONDS=15
# true = عند التشغيل ممنوع السكون/Pause — البوت نشط والإشارات مستمرة
BOT_FORCE_ACTIVE=true

# مراقبة البنية
WATCHDOG_ENABLED=true
WATCHDOG_CHAT_ID=
WATCHDOG_WINDOWS_HOST=169.58.15.36
WATCHDOG_WINDOWS_PORT=3389
WATCHDOG_CONTAINER=goldenshield-bot
WATCHDOG_STALE_MINUTES=15
WATCHDOG_REMIND_HOURS=6
WATCHDOG_CHECK_WINDOWS=true

# قاعدة البيانات
DB_PATH=storage/db/goldenshield.db

# التنفيذ: paper | live
EXECUTION_MODE=paper
EXECUTION_BACKEND=binance
MAX_CONCURRENT_POSITIONS=12

# دخول تلقائي من 90/100 فما فوق (درجة 9+)
AUTO_ENTRY_MIN_PERCENT=95
MANUAL_ENTRY_REQUIRED=false
# 0 = الدخول اليدوي بلا سقف عدد | التلقائي يبقى على MAX_CONCURRENT_POSITIONS وقواعد 90/100
MANUAL_MAX_CONCURRENT_POSITIONS=0
MAX_CONCURRENT_POSITIONS=12

# —— أرشيف عمل البوت للمراجعة الشهرية ——
REPORT_FILE_ARCHIVE_ENABLED=true
BOT_ACTIVITY_ARCHIVE_ENABLED=true
ACTIVITY_JOURNAL_ALWAYS=true
# REPORT_ARCHIVE_DIR=storage/reports

# —— جودة التحليل (طبقات مضافة — آمنة بالافتراضي) ——
# احتساب FVG/MR/Volume/SMC فقط إن وافقت اتجاه الأطر
DIRECTIONAL_COMPONENT_SCORING=true
# عدد شموع OHLCV للتحليل (حد أدنى 50)
OHLCV_ANALYSIS_LIMIT=100

# —— استراتيجية الربح الجزئي (Partial Take Profit) ——
# true = تفعيل TP1/TP2/TP3
PARTIAL_TP_ENABLED=true
PARTIAL_TP1_PCT=0.50
PARTIAL_TP2_PCT=0.30
PARTIAL_TP3_PCT=0.20
PARTIAL_TP1_R=1.0
PARTIAL_TP2_R=2.0
PARTIAL_TP3_R=3.0
PARTIAL_TP3_CLOSE_ENABLED=true
PARTIAL_TP_TRAIL_ENABLED=true

# بروتوكولات اختيارية (افتراضي: معطّلة)
HIGH_CONVICTION_MODE=false
STANDARD_BONUS_PROFILE=false

# —— v1.1.2 Pre-Execution / Emergency SL ——
PRE_EXECUTION_GATE_ENABLED=true
EMERGENCY_PROTOCOLS_ENABLED=true
EMERGENCY_ATR_SL_ENABLED=true
EMERGENCY_ATR_MULT=1.5
EMERGENCY_ATR_PERIOD=14
EMERGENCY_ATR_TIMEFRAME=15m
RISK_DISTANCE_FILTER_ENABLED=true
RISK_DISTANCE_MAX_SL_PCT=0.05
SL_RR_LOCK_ENABLED=true
SL_RR_LOCK_RATIO=3.0
VOLATILITY_GUARD_ENABLED=true
VOLATILITY_GUARD_EXPAND_MULT=1.5
REQUIRE_SL_ON_ALL_CHUNKS=true
CLOSE_NAKED_TICKETS=true
MANAGE_POSITIONS_DURING_HALT=true

# —— v1.3 أعلام اختيارية (تفاصيل YAML: institutional_v13) ——
# BINANCE_API_KEY_2 / SECRET_2 أعلاه للتبديل الاحتياطي
# عطّل/فعّل الطبقات عبر config/risk_params.yaml → institutional_v13

# —— v1.2 مؤسسي (افتراضي: معطّل — فعّل واحدة واحدة بعد أسبوع استقرار) ——
ADX_FILTER_ENABLED=false
ADX_MIN_TREND=20
ADX_PERIOD=14
ADX_TIMEFRAME=15m
MARKET_CORRELATION_FILTER_ENABLED=false
PANIC_MODE_BLOCK_LONG=true
PARTIAL_SCALING_ENABLED=false
PARTIAL_SCALING_INITIAL_PCT=50
PARTIAL_SCALING_ADD_PCT=50
PARTIAL_SCALING_TRIGGER_R=0.5
MICRO_SIMULATION_ENABLED=false
MICRO_SIMULATION_LOOKBACK=10
MICRO_SIMULATION_MIN_WINRATE=0.5
PROFIT_CAP_ENABLED=false
PROFIT_CAP_DAILY_PCT=3.0
SMART_TRADE_REPORT_ENABLED=false

# نشر Contabo (سكربتات scripts/ فقط — لا ترفع .env)
DEPLOY_HOST=
DEPLOY_USER=root
DEPLOY_PASSWORD=

# إدارة ويندوز VPS عن بُعد (SSH) — ضع القيم الحقيقية في Cursor Secrets فقط
WIN_HOST=
WIN_USER=Administrator
WIN_PASSWORD=

# تجربة
TRIAL_MODE=false
TRIAL_JOURNAL_ENABLED=true
BOT_ADMIN_FULL_ACCESS=true

# Google Drive (اختياري)
GDRIVE_CREDENTIALS_PATH=storage/gdrive_token.json
GDRIVE_FOLDER_ID=

# ملاحظة: MetaTrader / XM ملغى بالكامل — البوت Binance فقط
