# Saqr AI — Local Binance stack (copy to .env and fill keys)
PAPER_TRADING=True

BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_DEMO_TRADING=true
BINANCE_BASE_URL=https://demo-api.binance.com
BINANCE_WS_URL=wss://demo-stream.binance.com/ws
BINANCE_MARKET_REST_URL=https://api.binance.com
BINANCE_MARKET_WS_URL=wss://stream.binance.com:9443
STREAM_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT
STREAM_INTERVALS=1m,5m,1h,4h
WATCHDOG_RESTART_COOLDOWN=15

GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000

DB_PATH=saqr_local.db
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=3

SYNC_INTERVAL_SECONDS=5
WATCHDOG_STALL_SECONDS=30
ENGINE_TICK_SECONDS=2

# Risk guardrails
MAX_PORTFOLIO_HEAT_PCT=8.0
MAX_SPREAD_BPS=15
DEFAULT_STOP_MARKET=true
