# =============================================================================
# GoldenShield — ملف أسرارك (قالب)
# =============================================================================
# 1) انسخ هذا الملف إلى أحد الاسمين (لا ترفع الأسرار إلى GitHub):
#      .env                          ← في جذر المشروع (مُفضّل)
#    أو config/USER_SECRETS.env
# 2) املأ القيم بعد علامة = فقط
# 3) في Cursor Cloud: انسخ نفس المفاتيح إلى Dashboard → Secrets
# =============================================================================

# —— Windows VPS (RDP / SSH) ——
WIN_HOST=
WIN_USER=
WIN_PASSWORD=
# المفتاح الخاص كاملاً (بعد تثبيت المفتاح العام على VPS) — سطر واحد أو multiline
WIN_SSH_PRIVATE_KEY=

# —— Binance Demo ——
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_DEMO_TRADING=true
EXECUTION_MODE=paper
EXECUTION_BACKEND=binance
# اختياري عند حظر 451:
BINANCE_HTTPS_PROXY=

# —— Discord ——
DISCORD_NOTIFY_ENABLED=true
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_BOT_USERNAME=GoldenShield

# —— Telegram (اختياري) ——
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# —— مسار المشروع على VPS ——
GOLDENSHIELD_OFFICIAL_ROOT=C:\GoldenShield_Binance
