# =============================================================================
# GoldenShield — لابتوب (البوت محلياً) + لوحة Contabo
# انسخ إلى: .env في جذر المشروع على اللابتوب
# =============================================================================

ENV=dev
GOLDENSHIELD_OFFICIAL_ROOT=C:\GoldenShield

# —— Binance Demo (بدون بروكسي على IP المنزل) ——
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_DEMO_TRADING=true
EXECUTION_MODE=paper
EXECUTION_BACKEND=binance
BINANCE_SKIP_LOAD_MARKETS=true
PROXY_URL=

# —— Contabo (لمزامنة runtime → اللوحة) ——
WIN_HOST=
WIN_USER=
WIN_PASSWORD=
# WIN_SSH_PRIVATE_KEY=  # مُفضّل بدل كلمة المرور
RUNTIME_SYNC_REMOTE_ROOT=C:\GoldenShield_Binance
RUNTIME_SYNC_INTERVAL_SEC=15

# البوت محلي — لا تشغّل Mobile API على اللابتوب إلا للاختبار
MOBILE_API_PORT=8790
BOT_FORCE_ACTIVE=true
TRI_COMMANDER_MODE=true

# Discord (اختياري)
DISCORD_NOTIFY_ENABLED=false
